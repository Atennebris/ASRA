# LLM provider switch: opencode-zen (default — free, no key needed), qwen, mistral, openrouter,
# openai, anthropic, groq, xai, cerebras, nvidia, deepseek, moonshot, minimax, zai, gemini,
# perplexity, xiaomi, or a local provider running on this machine — lmstudio, ollama (no key
# needed for either).
LLM_PROVIDER=opencode-zen

# Create your own personal key:
#   1. Open https://modelstudio.console.alibabacloud.com/ (log in / create an Alibaba Cloud account if needed)
#   2. Left sidebar -> "Get Started" -> "First API call to Qwen"
#   3. On that page, "Account setup" section, step 3 "Get an API key" -> click the "API Key" link
#   4. On the API Key page, click "Create API Key"
# The key value is shown only once at creation — copy it into your local .env immediately.
QWEN_API_KEY=your_dashscope_api_key_here
QWEN_MODEL=qwen-plus
# Default endpoint below works for most accounts; if Model Studio shows you a
# dedicated workspace domain instead, use that "OpenAI Compatible Endpoint" URL here.
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Default provider. Free, no key needed for big-pickle (or minimax-m2.5-free, etc.).
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_MODEL=big-pickle
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1

# Off by default -- explicit opt-in only. When true, opencode-zen requests carry the same
# x-opencode-client/User-Agent/session-id headers the official opencode CLI itself sends, which the
# free tier evidently rate-limits far less aggressively than plain OpenAI-compatible API traffic
# (confirmed live: an anonymous request without these got HTTP 429 while the real CLI, same
# machine, same moment, succeeded). This makes ASRA's traffic represent itself as the official
# opencode CLI -- likely outside opencode.ai's own free-tier terms, real risk of harsher treatment
# if ever specifically detected. Only enable this for your own account/IP with that understood.
OPENCODE_ZEN_MIMIC_CLI=false

# Get a key at https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Get a key at https://openrouter.ai/settings/keys — one key, 300+ models from every major vendor.
OPENROUTER_API_KEY=your_openrouter_api_key_here
# openrouter/auto lets OpenRouter itself pick a model per-request instead of naming one here.
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Get a key at https://console.anthropic.com/settings/keys — routed through Anthropic's own
# official OpenAI-SDK compatibility endpoint (real chat/completions API), not a third-party shim.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Get a key at https://console.groq.com/keys — fast inference on open-weight models.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Get a key at https://console.x.ai — xAI's Grok models.
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-4.6
XAI_BASE_URL=https://api.x.ai/v1

# Get a key at https://cloud.cerebras.ai — Cerebras wafer-scale inference.
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# Get a key at https://build.nvidia.com — NVIDIA NIM hosted model endpoints.
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Get a key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Get a key at https://platform.moonshot.ai/console/api-keys
MOONSHOT_API_KEY=your_moonshot_api_key_here
MOONSHOT_MODEL=kimi-k2.5
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# Get a key at https://platform.minimax.io/user-center/basic-information/interface-key
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_MODEL=MiniMax-M2
MINIMAX_BASE_URL=https://api.minimax.io/v1

# Get a key at https://z.ai/manage-apikey/apikey-list — Zhipu AI's GLM models (Z.ai international
# endpoint below; https://open.bigmodel.cn/api/paas/v4 is the mainland-China equivalent).
ZAI_API_KEY=your_zai_api_key_here
ZAI_MODEL=glm-4.6
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# Get a key at https://aistudio.google.com/apikey — Gemini Developer API, routed through Google's
# own official OpenAI-SDK compatibility layer. Vertex AI (GCP project/service-account auth) is a
# separate integration, not covered by this key.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Get a key at https://www.perplexity.ai/account/api/keys — Sonar models carry built-in web search
# grounding but have no native tool-calling support (models.dev: tool_call=false for every Sonar
# model), so this project falls back to its own prompt-based tool-calling mode for it automatically.
PERPLEXITY_API_KEY=your_perplexity_api_key_here
PERPLEXITY_MODEL=sonar-pro
PERPLEXITY_BASE_URL=https://api.perplexity.ai

# Get a key at https://platform.xiaomimimo.com — Xiaomi's MiMo models.
XIAOMI_API_KEY=your_xiaomi_api_key_here
XIAOMI_MODEL=mimo-v2.5
XIAOMI_BASE_URL=https://api.xiaomimimo.com/v1

# Local providers below run on this machine, not in the cloud — no account, no key, as long as
# the server itself isn't put behind your own auth (LMSTUDIO_API_KEY/OLLAMA_API_KEY, left blank
# by default). Set the *_MODEL to whatever you actually have loaded/pulled locally — Settings'
# model dropdown queries the running server directly and lists it there once it's up.

# LM Studio: Developer tab -> "Start Server" (defaults to port 1234).
LMSTUDIO_API_KEY=
LMSTUDIO_MODEL=local-model
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1

# Ollama: `ollama serve` (usually already running as a background service after install).
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434/v1

# Port the FastAPI/uvicorn web server listens on.
PORT=8000

# Master switch for the exploitation step. false = detection + PoC only, no real exploitation.
ENABLE_EXPLOIT=true

# Max seconds to wait for a single LLM API response before giving up (and retrying, see
# agent/llm_client.py's backoff). Without this the openai SDK's own ~600s default can leave a
# scan silently hung for ten minutes on one slow/stuck request.
LLM_REQUEST_TIMEOUT_SECONDS=120
# Its own, much shorter timeout for "is a local LLM provider (LM Studio/Ollama) even running" --
# fired passively on every Settings page load, not something the operator is deliberately waiting
# on the way a real completion call is. Real, confirmed incident: on this project's own WSL2
# launch path, a connection attempt to a local provider's port with nothing actually listening took
# ~5.8s to fail (a WSL2/Windows networking quirk, not the app choosing to wait) -- reusing the
# full 120s LLM_REQUEST_TIMEOUT_SECONDS here would only make a "not running" local provider slower
# to report, never faster to actually detect.
LOCAL_MODEL_DISCOVERY_TIMEOUT_SECONDS=2

# How long (seconds) to wait for the opencode-local provider's own `opencode serve` process to
# finish starting up before giving up (agent/opencode_local_provider.py). Bump this on a slower
# machine or the CLI's own first-ever cold start on this install, if it keeps timing out.
OPENCODE_LOCAL_READY_TIMEOUT_SECONDS=20

# How long (seconds) after a failed opencode-local server start before the next independent
# trigger (Settings load, Test, Save, model-dropdown change) is allowed to retry it from scratch,
# instead of getting the same cached failure immediately (agent/opencode_local_provider.py). Real,
# confirmed incident this fixes: without a cooldown, every one of those UI actions re-spawned the
# whole server from scratch, every ~20s, indefinitely.
OPENCODE_LOCAL_FAILURE_COOLDOWN_SECONDS=15

# Pin the exact opencode CLI version the "Install opencode" button downloads (agent/opencode_install.py),
# e.g. 1.19.5. Empty = the newest 1.x release. Only ever a 1.x version: the opencode-local provider
# talks to the 1.x server API, which opencode 2.x does not offer.
OPENCODE_INSTALL_VERSION=

# Network timeout (seconds) for each request the "Install opencode" button makes to GitHub (release
# lookup + the ~75 MB download). Raise it on a slow or proxied connection.
OPENCODE_INSTALL_TIMEOUT_SECONDS=120

# How long (seconds) the Settings model-dropdown list per provider is cached before it's re-probed
# live. The Settings screen queries every provider's models on each render, and a local/custom
# endpoint that's down costs a real network timeout every time -- caching keeps repeat loads instant.
# A provider edit (endpoint/key/custom-provider change) clears its entry at once, so this only ever
# delays a brand-new upstream model showing up, by up to this many seconds.
MODEL_CHOICES_CACHE_TTL_SECONDS=30

# How long (seconds) the saved provider/model/fallback-chain settings file (agent/settings.py) is
# cached in memory before the next read re-opens it from disk -- real, confirmed incident this
# fixes: a caller that checks something per-provider (main.py's _provider_picker_context, looping
# over every built-in provider) ended up re-reading and re-parsing this file from disk once PER
# PROVIDER, ~80 times on a single page render. Self-invalidates on every save, so an edit in
# Settings is reflected on the very next read regardless of this TTL -- short on purpose (unlike
# the external-probe caches above, this is the operator's own core settings file, which should
# never feel laggy to update even from an unrelated process editing it directly).
LLM_SETTINGS_CACHE_TTL_SECONDS=2

# How long (seconds) the real "which tools are actually installed on this machine" list
# (agent/tools/tool_inventory.py) is cached before it's re-checked live. Settings' Tools tab and
# the Subagents tab's own tool checklist both call this on every single render -- real, confirmed
# incident this fixes: that's a real shutil.which()/availability_check() per registered tool
# (dozens of them) on every load, even though which tools are installed essentially never changes
# except right after the operator explicitly installs/uninstalls one from the Tools tab. This only
# ever delays a just-finished install/uninstall from showing up, by up to this many seconds.
TOOL_AVAILABILITY_CACHE_TTL_SECONDS=30

# How long (seconds) the saved display-timezone/clock settings (agent/timezone_settings.py) are
# cached in memory before the next read re-opens the file from disk -- real, confirmed incident
# this fixes: main.py's _human_dt Jinja filter calls load_display_timezone() once PER TIMESTAMP
# rendered, and a real session page with a lot of history (findings/logs/chat messages) profiled
# at 949 separate calls, each paying its own fresh disk read -- ~3.2s of a ~4.1s total page render
# on its own (cProfile-measured). Self-invalidates on every save, same short-TTL reasoning as
# LLM_SETTINGS_CACHE_TTL_SECONDS above.
TIMEZONE_SETTINGS_CACHE_TTL_SECONDS=2

# How long (seconds) list_session_summaries() (sessions/store.py) caches its own full result in
# memory before recomputing -- real, confirmed incident this fixes: even with that function's own
# on-disk summary-index cache, it still does a real path.exists() stat PER SESSION on every call,
# and a session page's own render calls it twice (once directly, once via the provider leaderboard)
# for identical results microseconds apart. Self-invalidates on every save_session() call.
SESSION_SUMMARIES_CACHE_TTL_SECONDS=1

# Cap on how long a single retry wait may be even when the provider's own Retry-After header on
# a 429 asks for longer (a shared/free endpoint under load can send back minutes) — without this
# cap a scan can sit fully silent, mid-thread, for however long the server dictates.
LLM_MAX_RETRY_AFTER_SECONDS=30

# Hard ceiling (seconds) on one Settings/subagent "Test" click. A Test only has to prove the model
# answers right now, so it gives up well before a scan's full retry budget (which can run ~12 minutes
# on a dead free-tier model). 0 disables the ceiling.
LLM_TEST_TIMEOUT_SECONDS=90

# How long a fallback-chain step (Settings -> Reserve providers) stays marked "exhausted" within
# one run before it's eligible to be retried again — a step's own budget being exhausted (rate
# limit, transient 5xx) doesn't mean it's dead forever, just temporarily. Without this cooldown a
# handful of concurrent transient failures (the main loop plus several subagent tasks, common with
# delegation enabled) can mark every configured step exhausted within minutes, permanently, and
# crash the whole session the next time any step needs a fallback — even though most of those
# steps would have recovered on their own given a few more minutes.
LLM_CHAIN_COOLDOWN_SECONDS=300

# When a time-budgeted session finishes a full pass with budget time still left, it normally starts
# another full pass (recon->reverify->...->skeptical_verification). This is the minimum fraction of
# this session's own average pass duration so far that must still remain before starting one more —
# below it, the loop stops cleanly instead of kicking off a pass almost certain to be cut off by the
# deadline before it can re-verify anything (a real, confirmed incident: a pass that finished with 3
# minutes left still started a new one, which died 2 tool calls into recon).
TIME_BUDGET_MIN_PASS_FRACTION=0.15

# Max seconds a single http_request call waits for a response before giving up (a model can raise
# this per-call via http_request's own optional "timeout" argument for a known-slow, legitimate
# endpoint like web.archive.org's CDX search API — this default stays short so a genuinely dead
# scan target still fails fast).
HTTP_REQUEST_TIMEOUT_SECONDS=10
# How many extra fast, local attempts http_request AND tcp_port_check make on a transient
# connection/DNS/timeout error before reporting failure -- a one-off resolver hiccup self-heals
# almost immediately, so this is cheaper than burning a full LLM round-trip on the "1-Step Retry"
# correction path. Raised from 2/1s to 4/1.5s after a real session where the old ~2s local-retry
# window still wasn't enough to survive the target's own resolver flip-flopping.
HTTP_REQUEST_RETRY_ATTEMPTS=4
HTTP_REQUEST_RETRY_DELAY_SECONDS=1.5

# curl-impersonate profile http_request falls back to (once, only for httpx.RemoteProtocolError --
# "Server disconnected without sending a response" -- after every local retry above is exhausted).
# Real incident this fixes: a WAF-fronted target rejected every plain-httpx attempt at the transport
# layer because its TLS/HTTP2 fingerprint doesn't look like a real browser's; no amount of retrying
# with the same fingerprint could fix that. See curl_cffi's own BrowserType enum for other valid
# values if this one ever stops blending in.
HTTP_IMPERSONATE_BROWSER=chrome124

# subdomain_enum (agent/tools/native.py) -- active DNS brute-force of a wordlist of prefixes
# against a base domain. Uses the operator-assigned wordlist (Settings -> Wordlists, role
# "subdomain_enum") when set, otherwise falls back to a small ~35-entry built-in list. This tool
# owns its own timeout (tier-1 native, no external subprocess kill switch) -- these three bound a
# real, large assigned wordlist so it can't hang the agent loop for hours.
# Max prefixes actually tried from an assigned wordlist file, even if the file itself has more.
SUBDOMAIN_ENUM_MAX_PREFIXES=5000
# Concurrent DNS resolutions in flight at once.
SUBDOMAIN_ENUM_MAX_WORKERS=30
# Hard wall-clock ceiling -- returns whatever was found so far once hit, rather than waiting for
# every prefix to finish resolving or time out.
SUBDOMAIN_ENUM_HARD_DEADLINE_SECONDS=90

# amass_enum (agent/tools/amass_runner.py) -- OWASP Amass active brute-force + recursion +
# wildcard-DNS detection. Minutes amass itself is told to respect via its own -timeout flag before
# giving up on a domain (the subprocess call's own external timeout is this plus a 60s buffer, not
# a separate knob -- see amass_runner.py).
AMASS_ENUM_TIMEOUT_MINUTES=2

# Max chars of extracted readable text web_fetch returns per page (a CVE advisory/GitHub write-up
# read for research, never the scan target itself) -- keeps one long page from blowing out a
# subagent's whole context budget. Raise it for a call that specifically needs to read further
# into a long page.
WEB_FETCH_MAX_TEXT_CHARS=8000

# Max real tool calls (web_fetch/browser_*/correct_finding/...) the session chat panel's own
# assistant may make within ONE turn before it's cut off and asked to summarize what it found
# instead of trying another call. 0 (default) = unlimited -- a genuine interactive browser check
# (navigate, snapshot, fill, click, evaluate, go_back) already needs several of these for one simple
# verification, so there's no safe one-size-fits-all ceiling. 0 previously meant "no cap at all" --
# real incident this default fixes: an RE-mode chat turn ran ~20 tool calls across 3.5 real hours
# (a garble-obfuscated Go crackme, NinthCircle-crackmes-usr_573a1e) with zero check-in, because
# nothing ever forced one. Hitting this cap does NOT abandon the turn mid-tool-call -- the current
# call still finishes, then one more LLM call (no tools) is asked to summarize what was actually
# found/done so far (agent/chat.py's own "You've used up your tool budget" message) -- a real
# checkpoint the operator can act on, not a blind timer that cuts reasoning off mid-thought. 12 is a
# middle ground: generous enough for a genuinely multi-step browser verification, low enough that a
# run can't go silent for hours before the operator hears anything back.
CHAT_MAX_TOOL_ITERATIONS=12

# How many times save_session retries its atomic file rename after a transient Windows/WSL2 file-
# lock (PermissionError) before giving up, and how long it waits between attempts. Sized to
# comfortably outlast several cycles of the session page's own 1s SSE poll (main.py's
# _SSE_POLL_INTERVAL_SECONDS) -- a browser tab left open on a session page polls that file
# indefinitely, even long after the scan itself finished, and survives a server restart via the
# browser's own EventSource auto-reconnect.
SAVE_SESSION_RETRY_ATTEMPTS=30
SAVE_SESSION_RETRY_DELAY_SECONDS=0.2

# How many times load_session retries a JSON parse failure ("Extra data") before giving up, and how
# long it waits between attempts. Covers a different failure shape than the write-side retry above:
# save_session's own os.replace() can report success with no exception at all, yet a load_session
# landing at that exact instant on the same DrvFS path still reads a valid JSON object followed by a
# leftover tail from the previous (longer) file. Confirmed to self-heal within a few seconds.
LOAD_SESSION_RETRY_ATTEMPTS=20
LOAD_SESSION_RETRY_DELAY_SECONDS=0.2

# Max seconds the check_disclosed_reports tool may spend on its own internal LLM reserve-chain
# retry before giving up and letting the exploit phase continue without it. This tool bypasses the
# normal subprocess/subagent timeout machinery entirely (see agent/core.py's _dispatch_tool), so
# without its own explicit deadline a slow/rate-limited free-tier provider (confirmed live: ~600s
# per attempt against OpenRouter, 5x LLM_REQUEST_TIMEOUT_SECONDS, because the provider's own
# keep-alive bytes keep resetting httpx's per-chunk read timeout) can block the entire exploit
# phase for hours over a best-effort duplicate-report check.
DISCLOSED_REPORTS_TIMEOUT_SECONDS=300

# Max seconds a single recon/scan tool call (nmap, native tools) may run before timeout. NOT
# nuclei (NUCLEI_TIMEOUT_SECONDS below is its own, separate knob).
TOOL_TIMEOUT_SECONDS=600
# Max seconds a single exploit-tool call (Metasploit, sqlmap) may run before timeout.
EXPLOIT_TIMEOUT_SECONDS=600
# Max seconds a single nuclei call may run before timeout -- its OWN knob, not
# TOOL_TIMEOUT_SECONDS above. Real, confirmed incident: against a real target, nuclei's default
# tag set never finished even once in 4/4 attempts at TOOL_TIMEOUT_SECONDS=600 -- a live diagnostic
# run showed why (stuck checking for a newer official template set over a slow network path, not
# the scan itself; agent/tools/builders/nuclei.py now always passes -duc so a real scan never
# blocks on that check again). 1200 is a reasoned safety-net default for the scan itself, not a
# tightly measured one -- the live isolation run meant to pin this exactly was interrupted by an
# unrelated out-of-memory kill.
NUCLEI_TIMEOUT_SECONDS=1200
# Max seconds a single custom_re_script (model-written Python PoC, incl. wine-driven RE runs) may
# run before timeout. Its OWN short knob, NOT EXPLOIT_TIMEOUT_SECONDS above: a crackme driven
# through wine that never gets its stdin fed/closed sits at its prompt until timeout, so a large
# EXPLOIT_TIMEOUT_SECONDS would mean minutes of unstoppable dead time per hung script. Raise only if
# a genuine local PoC needs longer.
CUSTOM_SCRIPT_TIMEOUT_SECONDS=180
# Max seconds a single call to an operator-registered "(custom)" tool (Settings -> Tools -> Custom
# tools, agent/tools/custom_tool_runtime.py) may run before timeout -- its own knob, same reasoning
# as CUSTOM_SCRIPT_TIMEOUT_SECONDS above: an unfamiliar binary hanging (waiting on a prompt that
# never comes) shouldn't eat the much larger EXPLOIT_TIMEOUT_SECONDS budget every other exploit-
# class tool call also waits on.
CUSTOM_TOOL_TIMEOUT_SECONDS=180
# Max seconds Settings -> Tools -> Custom tools' own `<path> --help`/`-h` usage-hint capture
# (agent/tools/custom_tools_root.py's capture_usage_hint) waits per flag before giving up -- a
# binary that prints an interactive prompt instead of real help text must not hang the "Add" click.
CUSTOM_TOOL_USAGE_HINT_TIMEOUT_SECONDS=5
# Max seconds a single forge_poc_run call (agent/tools/native.py) may run before timeout -- its own,
# longer knob than CUSTOM_SCRIPT_TIMEOUT_SECONDS above: compiling a real Foundry test PLUS forking
# real chain state (a real network round trip to whatever RPC the PoC's own vm.createSelectFork
# call names) is genuinely slower than a plain local Python script.
FORGE_POC_TIMEOUT_SECONDS=300
# Hard ceiling on tshark_capture's own duration_seconds (agent/tools/builders/tshark.py) --
# a model-requested duration longer than this is silently clamped down to it, never rejected.
# Kept well under TOOL_TIMEOUT_SECONDS so a live capture always finishes with room left for
# tshark's own dissection/output pass, not right at the subprocess timeout's own edge.
TSHARK_CAPTURE_MAX_SECONDS=120
# Max seconds an RE baseline-triage pass (run_re_triage) may run before its wall-clock backstop
# stops it. Much tighter than the whole-pipeline 2h backstop because triage is meant to be a short,
# record-then-stop pass; a runaway that records nothing otherwise grinds for hours.
RE_TRIAGE_WALLCLOCK_SECONDS=1800
# How many RE-triage tool calls in a row with nothing recorded (no finding/hypothesis/target-profile
# fact) before the pass is stopped as spinning. Catches the record-nothing grind the back-to-back
# stall detector can't.
RE_TRIAGE_PROGRESS_STALL=25
# Max total tool calls an RE baseline-triage pass may make across its whole run, regardless of
# wall-clock time or whether it's making progress. Catches a pass that keeps making different,
# individually successful calls without ever wrapping up -- the chat panel's own
# CHAT_MAX_TOOL_ITERATIONS caps a turn's calls the same way.
RE_TRIAGE_MAX_TOOL_CALLS=50
# Max seconds Settings -> Optional interpreters/compilers' "Install" button waits for a package
# manager install (apt-get/dnf/pacman) before giving up and showing the manual-install fallback.
CAPABILITY_INSTALL_TIMEOUT_SECONDS=300
# Tools page -> "Install" button (agent/tools/arsenal_install.py): FALLBACK rough estimate of the
# arsenal's on-disk size, shown in the confirm warning ONLY on a fresh machine where there's nothing
# installed to measure yet. Once the arsenal exists, the panel shows the REAL measured size instead
# (measure_arsenal_size_gb over the actual install locations). A single number, not a range -- the
# exact fresh-install size legitimately varies with the distro and which shared deps are already
# present, but ~4 GB is the honest ballpark (measured ~3 GB of tools + shared apt deps).
ARSENAL_INSTALL_APPROX_GB=4
# How many trailing lines of the arsenal install log the live panel tails on each 2s poll.
ARSENAL_INSTALL_LOG_TAIL_LINES=400
# Tools page -> "Install (heavy)" button (agent/tools/arsenal_install.py): rough estimate of the
# heavy arsenal's on-disk size, shown in ITS OWN confirm warning.
# Always shown, not just a fresh-machine fallback -- there's no real `du`-based measurement for this
# one (its install locations are too varied/operator-configurable, e.g. GHIDRA_INSTALL_DIR below).
ARSENAL_HEAVY_INSTALL_APPROX_GB=15-25
# setup_tools_heavy.sh: where Ghidra gets installed/looked for. Leave unset for the default
# (/opt/ghidra) -- override only if you want it somewhere else (e.g. a drive with more room), or
# already have Ghidra installed at a non-default path (TOOLS_CUSTOM_ROOT above is usually the
# better fit for "already installed somewhere else" -- use this one only for the heavy INSTALLER's
# own target path).
GHIDRA_INSTALL_DIR=
# setup_tools_heavy.sh: which JDK package/Homebrew formula to install for Ghidra, when none is
# already on PATH (apt/dnf/pacman package name on Linux, Homebrew formula name on macOS, e.g.
# openjdk@21). Leave unset for the platform's own current default -- override if that default
# turns out too old for whatever Ghidra release is latest when you run the installer (its own
# install_ghidra function explains why this can't just be hardcoded to one JDK version).
GHIDRA_JDK_PACKAGE=
# Override for analyzeHeadless's own resolved path (agent/tools/builders/ghidra.py), same
# {TOOL}_PATH convention as NMAP_PATH/HTTPX_PATH -- leave unset to resolve it from the system PATH
# (what setup_tools_heavy.sh's own install_ghidra puts there) or, failing that, TOOLS_CUSTOM_ROOT.
ANALYZEHEADLESS_PATH=
# agent/tools/builders/ghidra.py: how long to wait for the per-project Ghidra SERVER process to
# become ready -- covers a first-time full auto-analysis (`-import`, can take several minutes on a
# large/complex target) or a quick reopen (`-process -noanalysis`, seconds). NOT the per-request
# budget once the server is already confirmed alive -- see GHIDRA_SOCKET_REQUEST_TIMEOUT_SECONDS.
GHIDRA_ANALYSIS_TIMEOUT_SECONDS=600
# agent/tools/builders/ghidra.py: timeout for ONE already-connected request/response round trip
# against an already-running Ghidra server. Short relative to the server-start budget above since
# the expensive part (full analysis) is already done by the time a request is actually sent.
GHIDRA_SOCKET_REQUEST_TIMEOUT_SECONDS=120
# agent/tools/builders/ghidra.py: how long the persistent per-project Ghidra server waits with no
# new connection before self-terminating. Real safety net, not just a resource-saver -- an ASRA
# process that crashes/gets killed must not leave an orphaned Ghidra JVM running forever; this
# bounds that regardless of what the Python side does or fails to do on exit.
GHIDRA_SERVER_IDLE_TIMEOUT_SECONDS=900
# agent/tools/builders/binary_semantic_diff.py: cap on added/removed/changed entries returned per
# list (same honest-cap-with-total-count convention as radare2.py's own _MAX_LIST_ENTRIES) -- two
# genuinely unrelated binaries can produce hundreds of entries.
BINARY_DIFF_MAX_LIST_ENTRIES=50
# agent/tools/builders/binary_semantic_diff.py: how many common-by-name functions get the expensive
# Ghidra decompile-and-content-digest treatment per call -- a real cost ceiling, not a correctness
# knob; a large shared binary can have hundreds of functions present in both versions.
BINARY_DIFF_MAX_DEEP_FUNCTIONS=10
# agent/tools/builders/radare2.py: avoids re-running the full, expensive `aaa` whole-binary analysis
# on every disassemble_function/decompile_function call against the same unchanged file -- a
# single-function `af @ <address>` plus name replay is used instead once a prior cold call's own
# `aflj` has cached a name->address map for that exact file (by path+mtime). Set to "false" to turn
# this off completely and always pay the full `aaa` cost, byte-identical to before this existed --
# a real escape hatch, not just a performance knob, if a real-world case ever needs it.
RADARE2_WARM_PROJECT_CACHE=true
# Override for unblob's own resolved path (agent/tools/builders/unblob.py), same {TOOL}_PATH
# convention as NMAP_PATH/ANALYZEHEADLESS_PATH -- leave unset to resolve it from the system PATH
# (where `pip install unblob`, setup_tools_heavy.sh's own install_unblob, puts its console script)
# or, failing that, TOOLS_CUSTOM_ROOT.
UNBLOB_PATH=
# agent/tools/builders/unblob.py: timeout for one extraction run. Generous on purpose -- a deeply
# nested firmware image (unblob's own default recursion depth is 10) can take a while to fully
# unpack; a small file/archive finishes in seconds.
UNBLOB_EXTRACT_TIMEOUT_SECONDS=300
# agent/tools/builders/unblob.py: where each extraction's own output/report lands. Deliberately
# NOT this project's usual fixed Documents-mounted app-data location -- confirmed live that unblob
# fails outright on that Windows-mounted (drvfs) path under WSL2 (a real, confirmed incompatibility,
# not a parallelism issue -- see that module's own comment). Must stay a genuinely native Linux
# filesystem path; override only if you have a reason to move it elsewhere on that same filesystem.
UNBLOB_RUNS_DIR=/tmp/asra-unblob-runs
# agent/tools/builders/sigrok_cli.py: how long (ms) a capture runs when neither time_ms nor
# samples is given in the call -- a real ceiling so a capture can never run indefinitely.
SIGROK_DEFAULT_CAPTURE_TIME_MS=1000
# agent/tools/js_bundle_graph.py: how many bytes of a local JS bundle file are read before
# truncating -- minified bundles can be multi-MB, this is a real ceiling, not a parsing limit.
JS_BUNDLE_GRAPH_MAX_BYTES=10000000
# agent/tools/electron_surface.py: how large an ASAR archive's own header/file-tree (not the whole
# archive -- just its JSON index) is allowed to be before this tool refuses it. A real admission
# ceiling, same spirit as the ASAR format's own documented header-size safety limit.
ELECTRON_SURFACE_MAX_ASAR_HEADER_BYTES=67108864
# Override for a 'go' toolchain's own resolved path (agent/tools/builders/go_buildinfo.py), same
# {TOOL}_PATH convention as UNBLOB_PATH/ANALYZEHEADLESS_PATH -- leave unset to resolve it from the
# system PATH or, failing that, TOOLS_CUSTOM_ROOT. mode="buildinfo" works even with none found (a
# pure-Python fallback scan); only mode="nm_symbols" genuinely requires it.
GO_PATH=
# agent/tools/builders/go_buildinfo.py: timeout for one `go version -m` / `go tool nm` run.
GO_BUILDINFO_TIMEOUT_SECONDS=60
# agent/tools/builders/go_buildinfo.py: how many bytes from the start of the file are scanned for
# the embedded modinfo text blob when no 'go' toolchain is available -- a real ceiling against
# reading a huge binary into memory for nothing, generous relative to how small that blob is.
GO_BUILDINFO_FALLBACK_SCAN_BYTES=67108864
# Override for WABT's own install directory (agent/tools/builders/wasm.py) -- wasm-validate/
# wasm-objdump/wasm2wat are resolved from here first, same {TOOL}_PATH convention as GO_PATH, but
# one shared directory for all four since they ship together as one package. Leave unset to
# resolve each from the system PATH or, failing that, TOOLS_CUSTOM_ROOT.
WABT_PATH=
# agent/tools/builders/wasm.py: timeout for one wasm-validate/wasm-objdump/wasm2wat run.
WASM_ANALYZE_TIMEOUT_SECONDS=60
# setup_tools_heavy.sh: where pwndbg gets cloned/installed. Leave unset for the default
# (/opt/pwndbg).
PWNDBG_INSTALL_DIR=
# Tools page -> "Nuclei template packs" section (agent/tools/nuclei_template_packs.py): how many
# trailing lines of a pack's sync log the live panel tails on each 2s poll.
NUCLEI_PACK_INSTALL_LOG_TAIL_LINES=200

# How long (seconds) a nuclei template pack sync can run before the live panel flags it as
# abnormally long (still polling, not auto-cancelled -- a Cancel button is offered either way).
# Generous by default: the heaviest pack here (~81k templates) genuinely can take several real
# minutes just to load once installed, so the clone itself needs real headroom too.
NUCLEI_PACK_INSTALL_STALL_SECONDS=900
# Project backups (agent/tools/project_backup.py, session page's "Backups" panel): true = a
# background loop periodically snapshots any project whose session.json changed since its own last
# backup. false = the manual "Backup now" button still works, just nothing runs unattended.
PROJECT_AUTO_BACKUP_ENABLED=true
# How often (seconds) the auto-backup loop checks every project for changes worth snapshotting.
PROJECT_AUTO_BACKUP_INTERVAL_SECONDS=3600
# How many backups to keep per project -- older ones are rotated out (deleted) right after a new
# one is created, whether that backup was manual or automatic.
PROJECT_BACKUP_MAX_COUNT=5
# WARNING: this is your real Linux/WSL2 sudo password, stored here IN PLAIN TEXT (not hashed, not
# encrypted -- it has to be readable to actually feed sudo). Empty by default -- with nothing set,
# Settings -> Optional interpreters/compilers' "Install" button still works, just fails fast and
# falls back to a manual copy-paste command instead of installing automatically when sudo needs a
# password. Only set this if you understand and accept that tradeoff (Settings has its own
# double warning before saving this). Never commit a real value here -- this file is a template.
SUDO_PASSWORD=
# true = pause before each exploit attempt and wait for a human to click Approve/Deny in the UI.
# false (default) = autonomous mode, exploitation proceeds immediately (auto-approved, still logged
# in session["approvals"] as "auto_approved" for the audit trail). Scope/allowlist checks still
# apply either way -- this only gates the human-in-the-loop prompt, not target validation.
EXPLOIT_REQUIRE_APPROVAL=false
# Seconds to wait for human approval before a pending exploit attempt is skipped (only relevant
# when EXPLOIT_REQUIRE_APPROVAL=true).
EXPLOIT_APPROVAL_TIMEOUT_SECONDS=300

# Master kill switch for the cross-session technique playbook (agent/tools/playbook_store.py) --
# true = confirmed-exploit findings get captured into data/playbook/ and later sessions against a
# similarly fingerprinted stack (WAF vendor + tech keywords) get those techniques surfaced as a
# lead. false = fully disabled, no capture and no lookup.
PLAYBOOK_ENABLED=true
# true = a short LLM call at the end of a session merges near-duplicate playbook entries the
# session just captured and cleans up its local playbook_notes.md. false = deterministic capture
# still runs, just skips this cleanup pass (cheaper, slightly more duplication over time).
PLAYBOOK_DISTILL_ENABLED=true
# Max number of prior-session technique matches injected into a single Analyze/Exploit prompt.
PLAYBOOK_MAX_INJECTED_ENTRIES=5
# Auto-prune threshold: a technique surfaced this many times as a lead that never once preceded a
# confirmed finding is dropped as proven noise (attribution feedback loop). 0 disables pruning.
PLAYBOOK_PRUNE_MIN_INJECTIONS=8
# Embedding model for the playbook's semantic (meaning-based) search. The CONNECTION is always
# whatever LLM provider is active (main agent's, or the chat thread's in interactive mode); only
# this model name is defaulted. If the active provider has no embeddings endpoint, search silently
# falls back to keyword matching.
PLAYBOOK_EMBEDDING_MODEL=text-embedding-3-small
# Playbook confidence decay: a technique's "how proven" weight halves every this-many days since it
# last worked (WAF bypasses get patched), floored so a proven-but-old one still beats an untested one.
# 0 disables decay. PLAYBOOK_STALE_DAYS: a worked technique not confirmed within this window is flagged
# "stale — re-verify" in the UI and the agent's context. 0 disables the flag.
PLAYBOOK_DECAY_HALFLIFE_DAYS=365
PLAYBOOK_STALE_DAYS=180
# Playbook threat-intel: enrich a technique's CVEs with CISA KEV (actively-exploited catalog) + EPSS
# (exploit-probability) + CVE Program description/CVSS + public PoC-repo availability, so the agent
# prioritizes what's being exploited in the wild and has real context on hand. All best-effort
# and offline-tolerant (TTL-cached). Set THREAT_INTEL_ENABLED=false to disable, or TTL=0 for
# cache-only (never hit the network).
THREAT_INTEL_ENABLED=true
THREAT_INTEL_TTL_SECONDS=86400
THREAT_INTEL_FETCH_TIMEOUT_SECONDS=8
THREAT_INTEL_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
THREAT_INTEL_EPSS_URL=https://api.first.org/data/v1/epss
# CVE description/CVSS/affected-products source (CVE Program's own record repo, one file per CVE).
THREAT_INTEL_CVELISTV5_BASE_URL=https://raw.githubusercontent.com/CVEProject/cvelistV5/main
# Public-PoC-repo lookup: a THIRD signal, distinct from KEV/EPSS -- whether exploit code is already
# public. Unofficial/alpha source with undocumented rate limits and real noise (near-duplicate,
# zero-star, non-PoC repos observed live) -- treat a hit as a lead to verify, never as proof.
# Separate enable flag so this noisier signal can be turned off without losing KEV/EPSS/CVE-metadata.
THREAT_INTEL_POC_LOOKUP_ENABLED=true
THREAT_INTEL_POC_URL=https://poc-in-github.motikan2010.net/api/v1/
THREAT_INTEL_POC_RESULT_LIMIT=5

# Tool-selection memory (agent/tools/tool_memory_store.py) -- cross-session record of which SCAN
# TOOL actually produced signal against a target with a given tech/WAF fingerprint (separate from
# the playbook above, which remembers proven exploitation techniques/payloads, not tool choice).
# A tool not seen productive again within this many days is flagged "may be outdated" in the
# agent's context, never suppressed outright. 0 disables the flag.
TOOL_MEMORY_STALE_DAYS=180

# Library panel (agent/tools/library_store.py) -- safety ceiling on how many chunks (= sequential
# LLM calls) one source analysis run is allowed to make. Chunk count scales with document size /
# the chosen model's own context window with no cap of its own otherwise -- the same real source
# can be ~2 chunks against a large-context model or hundreds against a small-context one. The
# chunk estimate shown before Analyze already lets an operator see this coming; this is the
# backstop for when they click through anyway. 0 = unlimited (shown as the infinity symbol in the
# panel, never the number 0, which would read as "no chunks allowed" -- the opposite of what it
# actually means).
LIBRARY_MAX_CHUNKS=60
# How many source analyses (agent/tools/library_store.py) may run at once, in this process, before
# clicking Analyze on another card is refused with a clear "N already running" message instead of
# starting yet another fully independent, fully concurrent sequence of real LLM calls. Same
# 0 = unlimited convention as LIBRARY_MAX_CHUNKS above.
LIBRARY_MAX_CONCURRENT_ANALYSES=2

# Max seconds a single browser_* action (navigate/click/fill/...) may run before timeout --
# deliberately its OWN short knob, NOT TOOL_TIMEOUT_SECONDS below (a real incident: with
# TOOL_TIMEOUT_SECONDS=600, a single browser_navigate against a slow/bot-challenge-gated page hung
# the entire agent loop for ~10 real minutes -- a browser action either finishes in seconds or is
# genuinely stuck, it never legitimately needs nmap-scan-length patience).
BROWSER_ACTION_TIMEOUT_SECONDS=45
# How long (seconds) an idle browser_* automation session (agent/tools/browser_manager.py's
# per-session Playwright BrowserContext) can sit unused before the background reaper closes it --
# a crash/cancel safety net, not the primary cleanup path (that's each run's own finally block,
# which closes it the moment the run actually ends).
BROWSER_SESSION_IDLE_TIMEOUT_SECONDS=600
# Max number of simultaneous open browser_* automation sessions across the whole server -- each is
# a real, isolated Chromium browsing context, so this bounds memory the same way
# HYDRA_MAX_CONCURRENT_JOBS/SUBAGENT_MAX_CONCURRENT_TASKS below bound their own resource.
BROWSER_MAX_CONCURRENT_CONTEXTS=5
# How long (seconds) an idle memscan_* live-process memory-scan session (agent/tools/
# memscan_manager.py's own scanmem-backed session dict) can sit unused before the background reaper
# closes it -- a crash/cancel safety net, not the primary cleanup path (that's an explicit
# memscan_detach call); mirrors BROWSER_SESSION_IDLE_TIMEOUT_SECONDS above exactly.
MEMSCAN_SESSION_IDLE_TIMEOUT_SECONDS=600
# Max number of simultaneous open memscan_* sessions per project -- each is a real, live scanmem
# process attached to a running target; mirrors BROWSER_MAX_CONCURRENT_CONTEXTS above.
MEMSCAN_MAX_CONCURRENT_SESSIONS=2
# Windows live-memory bridge (desktop/src-tauri/src/mem_bridge.rs) -- the memscan_* tools'
# platform="windows" backend, reaching a REAL Windows process (ASRA's own agent runs inside WSL2,
# so the scanmem-backed default above can only ever see a Linux/WSL2 process). Read by the Rust
# desktop shell itself, not the Python backend; false disables the listener entirely (desktop app
# only -- a plain run.sh/run.bat launch never has this regardless of this value).
ASRA_MEM_BRIDGE_ENABLED=true
# Loopback/WSL-adapter-only port the Windows live-memory bridge listens on.
ASRA_MEM_BRIDGE_PORT=47219
# false launches a real, visible Chromium window instead of a headless one (agent/tools/
# browser_stealth.py's launch_headless) -- closes fingerprint gaps no page-level JS patch can
# touch, at the cost of needing an actual display on the machine running ASRA (WSLg, X11, a real
# desktop); a headless server/bare WSL2 without one has nothing to launch a window against, so
# this stays true by default.
BROWSER_HEADLESS=true

# Master switch for client-side (JS/DOM-executed) technology fingerprinting during Analyze
# (agent/tools/js_fingerprint.py) -- runs a real browser probe (window.jQuery/React/__NEXT_DATA__/
# meta-generator/etc., agent/tools/data/js_signatures.json) against each host right after whatweb,
# to catch technologies + versions that only ever appear after JS renders (invisible to WhatWeb's
# own static-HTML/header fingerprinting). false skips it entirely (Chromium never launched for this
# purpose) if the extra browser overhead isn't wanted.
JS_FINGERPRINT_ENABLED=true
# Max seconds one JS-fingerprint probe (navigate + evaluate, one host) may run before giving up --
# its own short knob, same reasoning as BROWSER_ACTION_TIMEOUT_SECONDS above; a failure here only
# ever skips this one enrichment, never blocks or fails the whatweb result it rides alongside.
JS_FINGERPRINT_TIMEOUT_SECONDS=45

# Master switch for the native Proxy/Repeater/Decoder/Comparer toolkit. false = no mitmproxy
# instance is started at all, browser_* sessions behave exactly as before this feature existed.
TOOLKIT_ENABLED=true
# Local port the built-in mitmproxy instance listens on for the agent's own Playwright browser
# sessions (agent/tools/browser_manager.py) -- not exposed for a third-party browser to point at,
# by design: it only needs to intercept the agent's own browser, not act as a system-wide proxy.
TOOLKIT_PROXY_PORT=8081
# Per-response-body cap (bytes) for passively captured Proxy traffic before it's written to
# traffic.jsonl -- a response over this size is truncated, not dropped (video/audio/font bodies
# are dropped to metadata-only regardless of size, see agent/tools/toolkit_proxy.py). Keeps one
# large media response or file download from ballooning a session's traffic store unbounded.
TOOLKIT_MAX_CAPTURED_BODY_BYTES=2000000
# Drops passively captured bodies to metadata-only (status/headers/URL/content-length still kept)
# for any host whose registrable domain isn't the session's own target (or a recon-discovered
# sibling subdomain) -- off-scope third-party traffic (ad/analytics beacons, a payment widget's
# own JS, a bug-bounty platform page opened for reference) was never useful target data but still
# paid the same storage cost as first-party traffic. false disables this filter entirely (every
# in-scope-content-type body is kept regardless of host, the pre-existing behavior).
TOOLKIT_SCOPE_FILTER_ENABLED=true
# How long (seconds) a session's own scope (target + recon-discovered hosts) is cached before
# being re-read from session.json -- balances catching a newly recon-discovered subdomain quickly
# against re-reading disk on every single proxied request Chromium fires.
TOOLKIT_SCOPE_CACHE_TTL_SECONDS=30
# Minimum body size (bytes) before this project bothers hashing it to detect an exact repeat of an
# already-captured response body within the same session (e.g. the same vendor JS bundle
# re-requested on every page navigation) -- small/tiny repeated bodies aren't the disk-bloat
# problem this exists for, so they're never hashed at all.
TOOLKIT_DEDUP_MIN_BODY_BYTES=50000
# Cap on how many distinct body hashes one session's dedup check remembers at once (oldest evicted
# first) -- bounds this cache's own memory use for a very long-running session.
TOOLKIT_DEDUP_MAX_HASHES_PER_SESSION=2000
# Max raw traffic.jsonl lines an HTTPQL-lite query (agent/tools/toolkit_query.py, the Site Map's
# filter box and list_captured_traffic's own `query` parameter) scans backward from the newest
# entry before giving up and reporting a truncated/partial match set -- bounds one query's cost on
# a very large capture instead of re-introducing the full-file-parse slowdown
# load_recent_traffic_entries was originally added to fix (see toolkit_store.py's own docstring).
TOOLKIT_QUERY_MAX_SCAN_LINES=20000

# Max concurrent in-flight requests one Intruder attack run or Sequencer live-collection pass
# fires at once (agent/tools/toolkit_intruder.py / toolkit_sequencer.py) -- an uncapped knob here
# is a real way to accidentally DoS the very target being tested, unlike a read-only tool.
INTRUDER_MAX_CONCURRENT_REQUESTS=5
# Hard ceiling on total requests one Intruder attack run can ever fire, regardless of how many
# payload lines were given -- a scoped, bounded assessment action, not an open-ended flood.
INTRUDER_MAX_ATTEMPTS=500

# Hard ceiling on request_count for one Racer run (agent/tools/toolkit_racer.py) -- deliberately
# much lower than INTRUDER_MAX_ATTEMPTS above: every one of these attempts targets the SAME
# endpoint at effectively the SAME instant (last-byte synchronization), a categorically more
# concentrated shock to the real target than an Intruder sweep spread over time.
RACER_MAX_REQUESTS=50
# Max seconds Racer waits to open each raw TCP/TLS connection before treating that attempt as a
# connection error.
RACER_CONNECT_TIMEOUT_SECONDS=10
# Max seconds Racer waits to read one attempt's full response (status line, headers, body) after
# releasing its final byte.
RACER_RESPONSE_TIMEOUT_SECONDS=10

# Max seconds a single hydra_start/web_login_bruteforce_start background job may run before it's
# force-killed and reported as {"status": "timeout"} -- these run genuinely in the background
# (agent/tools/background_jobs.py), not blocking the calling turn, but still need their own hard
# cap since a real credential brute-force otherwise has no natural end.
HYDRA_TIMEOUT_SECONDS=900
# Max background jobs (hydra_start/web_login_bruteforce_start combined) one session may have
# running at once -- a real cap, not a suggestion, so the model can't fire far more concurrent
# brute-force runs than reasonable just by calling this repeatedly.
HYDRA_MAX_CONCURRENT_JOBS=2

# Max seconds a single delegate_to_subagent task may run before it's force-cancelled and reported
# as {"status": "timeout"} -- a delegated Subagent runs as a genuinely concurrent asyncio.Task
# (agent/tools/subagent_tasks.py), not blocking the main agent's own turn, but still needs its own
# hard cap since an LLM conversation otherwise has no natural end. Raised from the original 900 --
# confirmed live (NinthCircle-crackmes-usr_04a301): a real RE-mode subagent hit this deadline
# repeatedly after only 3-9 tool calls, because a single radare2 `aaa` full-analysis pass on a real
# obfuscated binary can genuinely cost ~2m30s on its own -- an IDENTICAL radare2 command on the same
# unchanged file is now memoized (RESULT_CACHE_TTL_SECONDS below), but a first look, or a different
# address, still pays the full analysis -- leaving no real room for a multi-step investigation in the
# old budget. 1800s doesn't change anything for a fast web-pentest
# subagent task (this is a ceiling, not a floor -- it still finishes whenever it's actually done),
# only gives a genuinely slow one enough room to make real progress before being cut off.
SUBAGENT_TASK_TIMEOUT_SECONDS=1800
# Max seconds run_hypothesis_verification/_run_hypothesis_resolution_gate may spend investigating
# open session["hypotheses"] entries (agent/core.py) before giving up and letting the session
# complete with whatever's still unconfirmed -- its own, smaller budget than
# _PHASE_WALLCLOCK_LIMIT_SECONDS (7200s, sized for a whole Recon/Analyze/Exploit phase), since one
# or a handful of hypotheses is a much smaller unit of work.
HYPOTHESIS_PASS_TIMEOUT_SECONDS=900
# How many Chain passes (agent/core.py's _run_chain, the attack-chain/escalation phase run after
# Exploit) may run back-to-back in the same scan. A confirmed chain that produces a finding which
# still doesn't stand on its own for a bounty (see _finding_needs_escalation -- Low/Medium severity,
# or non_qualifying/unclear) automatically triggers another pass to push it further (e.g. a WAF
# bypass -> a hidden endpoint -> weak auth -> admin access), up to this many hops; it stops earlier
# on its own the moment a pass finds nothing new or reaches something that already qualifies.
CHAIN_MAX_HOPS=3
# Per-host seconds budgeted when agent/core.py's _auto_delegate_recon_overflow batches several
# discovered-but-out-of-literal-scope hosts into ONE delegated task -- multiplied by the batch size
# instead of reusing the flat SUBAGENT_TASK_TIMEOUT_SECONDS above. Real incident this fixes: a
# 6-host batch got the same flat 900s a single-host delegation gets and hit that deadline after 29
# genuinely successful tool calls with no final report ever produced.
SUBAGENT_AUTO_OVERFLOW_TIMEOUT_PER_HOST_SECONDS=300
# Max subagent tasks one session may have running at once. 0 (or any non-positive value) means no
# cap at all -- an explicit operator choice, real limits at that point come from the LLM
# provider's own rate limits, not this. Set to a positive number for an actual per-session cap.
SUBAGENT_MAX_CONCURRENT_TASKS=0

# TTL for cached external lookups (crt.sh/certspotter, wayback, exploit-db, cve).
CACHE_TTL_SECONDS=3600
# TTL for the cached models.dev model-capabilities catalog — deliberately longer than
# CACHE_TTL_SECONDS above, the catalog is large and rarely changes.
MODELS_DEV_CACHE_TTL_SECONDS=86400
# TTL for the deterministic-tool result cache (radare2's identical-command memoization). Long by
# design: the key embeds the input file's mtime, so a changed file can never get a stale hit.
RESULT_CACHE_TTL_SECONDS=86400

# Desktop start-screen preference: run the agent as root inside WSL (WSL_USER=root), skipping sudo
# for tools like nmap -O. Managed by the desktop shell's "Run the agent as root" toggle; leave
# false for the normal non-root run.
ASRA_RUN_AS_ROOT=false

# Which Linux distro the desktop launcher's "Install WSL"/"Install a Linux distro" button installs
# when none is registered yet (`wsl --install -d <this>`). Only a default -- change it if you'd
# rather the one-click install offer a different distro than Ubuntu.
ASRA_WSL_AUTO_INSTALL_DISTRO=Ubuntu

# Desktop shell preference: play the animated launch intro (desktop/src-tauri/dist/index.html)
# while the backend starts up. Managed together with ASRA_LAUNCH_LOADER_ENABLED below by
# Settings -> Customization -> Visual's "Launch screen" picker (agent/intro_settings.py) --
# absent or true = intro plays; false = the intro is skipped (see the loader flag below for what is
# shown instead). Read directly from this file by the Rust desktop shell
# (desktop/src-tauri/src/main.rs's get_start_config), which runs before the Python backend that
# owns every other Settings toggle even exists.
ASRA_INTRO_ENABLED=true

# Desktop shell preference: when the intro above is off, show the dragon progress bar while the
# backend starts (true, also the value when absent) or nothing at all (false -- the Start button
# just reads "Starting..."). Managed by the same "Launch screen" picker; ignored while
# ASRA_INTRO_ENABLED is true.
ASRA_LAUNCH_LOADER_ENABLED=true

# Desktop shell preference: play the intro's own synthesized sound (ambient warp-space drone plus
# the three glass-impact hits, all Web Audio -- no shipped audio files) alongside the animation
# above. Off by default (absent or false): the soundtrack does not work yet, so Settings -> Sounds
# shows it locked off and nothing writes this value. Only matters while ASRA_INTRO_ENABLED is also
# true.
ASRA_INTRO_SOUND_ENABLED=false

# true = quietly check for updates (git fetch) once at startup, in the background — the result feeds
# Settings -> Updates and the sidebar "update available" badge. false = only check when you press
# "Check for updates" in Settings.
UPDATE_CHECK_ON_STARTUP=true

# true = verbose debug logging to data/debug.log + colorized per-category console output.
DEBUG=false

# true = force every page render to re-read AND re-compile its .html template from disk on every
# single request, instead of serving a compiled cached copy (main.py, where Jinja2Templates is set
# up) -- ONLY for actively live-editing a template under WSL2 (the repo on a Windows drive mounted
# via 9p doesn't propagate mtime changes reliably, so Jinja's own auto_reload can't always tell an
# edited template apart from an unchanged one without this). Leave false for normal use -- real,
# confirmed incident this default avoids: every route measured ~300ms-1s+ of pure re-parse/
# re-compile cost on every single load with this left on, which is also why a sidebar page
# navigation's own loading bar became clearly visible instead of completing imperceptibly fast.
ASRA_TEMPLATE_HOT_RELOAD=false

# Windows only: font height (px) for run.bat's separate debug-log console window, applied via the
# registry (HKCU\Console) since the runtime API for this is broken on some Windows builds. Leave
# unset for run.bat's own default (28, already much bigger than conhost's tiny 16px default).
DEBUG_CONSOLE_FONT_SIZE=

# Size (columns x rows) of that same separate debug-log console window -- kept small by default so
# it doesn't dominate the screen. Leave unset for the script's own default (90x25); raise it if you
# want more of the log visible at once. Also honored (best-effort) by run.sh's own debug terminal
# window on Linux, for gnome-terminal/xterm specifically.
DEBUG_CONSOLE_WIDTH=
DEBUG_CONSOLE_HEIGHT=

# Where new project folders get created (agent/../projects/paths.py). Leave unset to
# auto-detect: Documents/ASRA Projects on Windows (via WSL2)/macOS/Linux. Set this to override,
# e.g. PROJECTS_DIR=/mnt/d/Pentests or PROJECTS_DIR=~/asra-projects.
PROJECTS_DIR=

# Optional override for any tool not on PATH, e.g. NMAP_PATH=/opt/nmap/bin/nmap or
# INTERACTSH_CLIENT_PATH=~/.local/bin/interactsh-client (blind SSRF/XSS confirmation —
# github.com/projectdiscovery/interactsh/releases, no separate server to run, the public
# oast.pro/oast.live/etc. servers work out of the box).
INTERACTSH_CLIENT_PATH=
# Optional override for amass, e.g. AMASS_PATH=/opt/amass/amass (setup_tools.sh installs it to
# /usr/local/bin/amass by default -- github.com/owasp-amass/amass/releases).
AMASS_PATH=
# httpx specifically is worth calling out: this project's OWN Python dependencies (requirements.txt)
# include a package also named `httpx` (an HTTP client library, unrelated to ProjectDiscovery's recon
# tool of the same name) — activating venv/ puts its console-script shim ahead of the real recon
# binary in PATH, and calling it fails with "pip install 'httpx[cli]'" every time. Set this to the
# real ProjectDiscovery binary's actual path (setup_tools.sh installs it to /usr/local/bin/httpx by
# default) to fix that shadowing; agent/tools/discovery.py's own liveness check already refuses to
# register the broken shim, but leaves the real recon tool unavailable until this is set.
HTTPX_PATH=
# One root directory holding a whole pre-existing set of tools already on disk, never installed
# through setup_tools.sh at all (e.g. carried over from another machine/distro) -- Settings -> Tools
# -> "Custom tools path". Accepts a Windows-style path (e.g. C:\path\to\tools) and translates it to its
# WSL2 mount form itself (/mnt/c/path/to/tools) -- type it either way. Last-resort fallback only: a tool's
# own {TOOL}_PATH override and the system PATH are both tried first; this just fills in what
# neither of those found, by searching a bounded depth under the root for each tool's exact
# executable name (not just <root>/<executable> and <root>/bin/<executable> -- a real nested
# install, e.g. Ghidra's own <root>/ghidra_<version>/support/analyzeHeadless, needs more than that).
TOOLS_CUSTOM_ROOT=
# How many directory levels under TOOLS_CUSTOM_ROOT to search for a tool's exact executable name.
# Deep enough for a realistic nested distribution without walking an effectively unbounded tree.
TOOLS_CUSTOM_ROOT_MAX_DEPTH=6
# How long (seconds) the custom-root file index is cached for the hot runtime lookup path
# (resolve_via_custom_root) before being rebuilt -- keeps a multi-gigabyte real tool collection
# from being re-walked on every single tool's own availability check, while still picking up a
# newly-added file after this many seconds. Settings -> Tools -> "Test path" never uses this
# cache -- it always re-walks live, so an explicit check is never stale.
TOOLS_CUSTOM_ROOT_INDEX_TTL_SECONDS=300
# qiling_emulate (RE mode's cross-platform binary emulator, agent/tools/builders/qiling.py --
# replaced the old Windows-only cdb tool). The Tools-page Install button installs the qiling package
# into ASRA's venv AND clones a rootfs collection to /opt/qiling-rootfs, which the tool uses by
# DEFAULT (auto-picking the per-arch subdir) -- so normally you leave this EMPTY. Set it only to
# override with a different rootfs (e.g. one you built with real Windows DLLs for full PE emulation;
# the free rootfs ships the Windows dir structure but not the DLLs, for licensing reasons).
QILING_ROOTFS=

# New Project dialog's "Study program page / Use this link as the target" wizard buttons
# (agent/tools/bugbounty_import.py) -- how long to let a bug-bounty program page (HackerOne/
# Bugcrowd/YesWeHack are all client-rendered SPAs, confirmed live) keep hydrating after Playwright's
# own "networkidle" fires before reading its text -- networkidle only means no in-flight request for
# 500ms, which is often before a chatty React app has finished turning its last API response into
# rendered DOM text.
BUGBOUNTY_IMPORT_RENDER_SETTLE_SECONDS=3
# Max chars of a program page's own rendered text sent to the LLM extraction call -- same spirit as
# WEB_FETCH_MAX_TEXT_CHARS above, keeps one very long program brief from blowing the context budget.
BUGBOUNTY_IMPORT_MAX_PAGE_CHARS=40000
# Max seconds the "Use this link as the target" button waits for a target's own
# /.well-known/security.txt (RFC 9116) before giving up -- a quick, best-effort real-value check
# (real published contact/policy info), not a hard requirement; most sites have no security.txt at
# all and this should fail fast rather than stall the button.
BUGBOUNTY_IMPORT_SECURITY_TXT_TIMEOUT_SECONDS=5
# HackerOne's own /policy_scopes route is a GraphQL-paginated "load more on scroll" list, not a
# plain static table (confirmed live: a real 44-asset program only ever showed ~19 on one read) --
# max real wheel-scroll rounds before giving up on loading any further rows, and how long to let
# each round's own GraphQL round trip + re-render settle before checking for new content.
BUGBOUNTY_IMPORT_SCOPE_HARVEST_MAX_ROUNDS=20
BUGBOUNTY_IMPORT_SCOPE_HARVEST_SETTLE_SECONDS=1.2
# How often (seconds) a project with session["program_url"] set may re-fetch its program's own
# Hacktivity/reachability check -- agent/core.py calls this once per phase transition
# (recon/analyze/exploit), but this TTL makes every call after the first in a session a cheap
# no-op read until this many seconds have passed. 900s (15 min) is a starting point, not a
# measured constant: a Hacktivity feed doesn't change fast enough to justify a real browser fetch
# on every phase transition, but a multi-hour session should still notice new disclosures well
# before it ends.
BUGBOUNTY_IMPORT_HACKTIVITY_REFRESH_SECONDS=900

# Unicode font for the PDF export format (agent/utils/report_export.py) -- defaults to DejaVu Sans
# (fonts-dejavu-core, a common Linux distro package, already present on this project's own dev
# machine), so finding text outside Latin-1 (e.g. Cyrillic, most punctuation dashes/bullets) still
# renders correctly. Optional: if the font isn't found at the default path, PDF export falls back
# to a Latin-1-only core font instead of failing, same "optional override, graceful degrade"
# convention as NMAP_PATH/HTTPX_PATH above. Set both together (a mismatched bold weight looks worse
# than none) if your distro installs DejaVu somewhere else, or you'd rather use a different font.
PDF_FONT_REGULAR_PATH=
PDF_FONT_BOLD_PATH=

# smuggling_probe (agent/tools/smuggling.py) -- HTTP request smuggling/desync timing
# technique. How long to wait for a first response byte on the CL.TE/TE.CL variants before treating
# "no response yet" as itself the positive signal (the backend genuinely stuck waiting on a chunk
# continuation that never arrives).
SMUGGLING_PROBE_READ_TIMEOUT_SECONDS=10
# A malformed variant responding this many seconds slower than the clean baseline counts as a
# candidate desync, even if it eventually responds within the read timeout above.
SMUGGLING_PROBE_DELAY_THRESHOLD_SECONDS=5

# waf_evasion_probe (agent/tools/waf_evasion.py) -- how many filler bytes its padding_overflow
# mutation prepends to the payload, aiming to push the field past a WAF's own body-inspection
# limit (8192 matches AWS WAF's own commonly-documented default; raise it if a target's WAF is
# known to inspect a larger window).
WAF_EVASION_PADDING_BYTES=8192

# Master kill switch for the cross-session asset baseline (agent/tools/asset_baseline_store.py) --
# true = asset_diff_check persists what Recon found into data/asset_baseline/ and diffs it against
# the same target's own prior baseline, surfacing what's new/removed since the last scan. false =
# the tool returns status="disabled" without reading or writing anything.
ASSET_BASELINE_ENABLED=true

# Operator notifications (agent/tools/notifications.py) -- optional. When set, a plain JSON POST
# ({"content": "...", "text": "..."} -- Discord and Slack incoming webhooks each read the field
# they recognize) fires when a session completes/fails. Blank (the default) = no notifications at
# all, nothing is sent anywhere. Point this at a Discord/Slack incoming webhook URL, or any
# endpoint that accepts a plain JSON POST.
NOTIFY_WEBHOOK_URL=

# Fleet mode (agent/tools/fleet_store.py) -- max sessions the background fleet worker will run at
# once from the queue (the New Project page's "Queue for fleet mode" button, /fleet page). Manually
# clicking "Start" on individual projects is never capped by this -- only the fleet queue itself is.
FLEET_MAX_CONCURRENT_SESSIONS=3
# How often (seconds) the fleet worker checks for free capacity / queued work.
FLEET_POLL_INTERVAL_SECONDS=5
# How often (seconds) agent/utils/crash_diagnostics.py refreshes Documents/ASRA/last_run_state.json
# -- the heartbeat file a future startup reads to tell a clean shutdown apart from the process
# vanishing with no warning (a WSL2 VM restart, an OOM, a forced kill). Lower = less time between
# "last known alive" and the actual moment of death, at the cost of a bit more disk I/O.
ASRA_HEARTBEAT_INTERVAL_SECONDS=5
# true = throttle the fleet queue's own auto-launch below FLEET_MAX_CONCURRENT_SESSIONS when the
# host is genuinely under real CPU/RAM load (thresholds below) -- never raises the cap above it,
# only narrows it further. false (default) = always use the static FLEET_MAX_CONCURRENT_SESSIONS.
# Never affects a session the operator starts by hand, only how many EXTRA queued ones auto-start.
FLEET_DYNAMIC_CONCURRENCY_ENABLED=false
# CPU/RAM percent thresholds (only checked when FLEET_DYNAMIC_CONCURRENCY_ENABLED=true) -- at or
# above either one, the fleet queue's own concurrency cap drops to FLEET_DYNAMIC_MIN_CONCURRENT_SESSIONS.
FLEET_DYNAMIC_CPU_THRESHOLD=80
FLEET_DYNAMIC_MEMORY_THRESHOLD=85
# Floor the fleet queue's cap is throttled down to under real load (never below 1).
FLEET_DYNAMIC_MIN_CONCURRENT_SESSIONS=1

# Standalone Terminal tab (agent/tools/terminal_manager.py) -- a real PTY-backed system shell, not
# an agent tool. Leave empty to auto-detect: your own $SHELL, falling back to /bin/bash. Set this
# to override, e.g. TERMINAL_SHELL=/usr/bin/zsh.
TERMINAL_SHELL=
# How much recent PTY output (KB) each terminal keeps in memory so a reconnect (page reload, tab
# switch) can replay its scrollback instead of showing a blank screen. Not the on-disk transcript
# (unbounded, one timestamped file per session under Documents/ASRA/console-logs/) -- just what's
# needed to redraw the live view.
TERMINAL_SCROLLBACK_KB=200

# Per-tool API keys (Settings -> Tool API Keys, agent/tools/tool_api_keys.py's TOOL_API_KEY_SPECS)
# -- optional, each tool works fine without its own key, this just unlocks extra data (e.g. a
# vulnerability-database cross-reference). Saved from that Settings screen, not something you
# normally hand-edit here.
# Get a key at https://wpscan.com/profile — WPScan's own Vulnerability Database API token, passed
# as --api-token on every wpscan call once set.
WPSCAN_API_KEY=
# Free at https://otx.alienvault.com/api — AlienVault OTX passive-DNS lookup (agent/tools/native.py's
# otx_passive_dns). Unlike the other keys on this page, this tool is fully disabled (not just
# degraded) with no key set — OTX has no meaningful anonymous access.
OTX_API_KEY=
# Free at https://urlscan.io/user/profile/ — urlscan.io historical-scan search (agent/tools/native.py's
# urlscan_search). Works with no key too, on urlscan's own shared/lower public rate limit.
URLSCAN_API_KEY=
# Free at https://github.com/settings/tokens/new — a classic Personal Access Token with ZERO scopes
# checked (it only proves "a real account"; searching public code needs no permissions). GitHub
# code search (agent/tools/native.py's github_code_search) is fully disabled without one — GitHub
# rejects an anonymous /search/code call outright.
GITHUB_API_KEY=
# Paid, at https://haveibeenpwned.com/API/Key — Have I Been Pwned breach-exposure lookup
# (agent/tools/native.py's hibp_breach_check). Fully disabled without a key — HIBP has no anonymous
# email-search access at all. The free xposedornot_check/hibp_password_check tools need no key.
HIBP_API_KEY=

# Sidebar "My IP" block (templates/base.html) -- on-demand egress IPv4/IPv6 lookup, fetched
# only when the operator clicks the eye icon, never polled (so a VPN switched mid-session shows
# its own exit IP on the very next reveal). See agent/public_ip.py.
# Plain-text IPv4-only lookup service -- must answer a GET with nothing but the address.
PUBLIC_IP_V4_URL=https://api.ipify.org
# Plain-text IPv6-only lookup service -- same contract as above, over an IPv6-only endpoint.
PUBLIC_IP_V6_URL=https://api6.ipify.org
# Per-request timeout for each lookup (IPv4/IPv6 run concurrently, each bounded by this).
PUBLIC_IP_TIMEOUT_SECONDS=4
# Tiny server-side cache TTL -- absorbs a double-click without a second real request; kept
# short so a VPN switch never looks stale for long. 0 disables caching entirely.
PUBLIC_IP_CACHE_SECONDS=5
# Seconds a revealed IP stays on screen before the sidebar hides it again on its own
# (static/js/public_ip.js) -- also hidden immediately if the tab/page becomes hidden.
PUBLIC_IP_AUTOHIDE_SECONDS=30

# Static css/js URLs in the templates carry the file's own modification time as ?v= so an edited
# file is never served stale from the browser/webview cache (agent/utils/static_url.py). Each
# file's time is re-checked at most once per this many seconds (a stat is slow on a repo that lives
# on a Windows drive mounted into WSL2). 0 = re-check on every page render.
STATIC_URL_CACHE_SECONDS=10
# Max AFL++ fuzzing runs (afl_fuzz_start) one session may have running at once -- a real cap, not a
# suggestion: every run pins a CPU core for its whole duration, so many parallel ones starve the rest.
AFL_MAX_CONCURRENT_JOBS=1
# Overall seconds budget for one wine_debug session (agent/tools/wine_debug.py: winedbg proxy startup
# plus the gdb client round trip against a Windows PE running under wine). Raise only if a heavy
# binary's first-run wine prefix initialization genuinely needs longer.
WINE_DEBUG_TIMEOUT_SECONDS=180
# Same idea as the per-host budget above, for the other two auto-delegations in agent/core.py: seconds
# per host when several confirmed hosts are batched into one delegated Analyze task, and seconds per
# finding when surplus findings are batched into one delegated Exploit task (multiplied by batch size).
SUBAGENT_AUTO_ANALYZE_TIMEOUT_PER_HOST_SECONDS=300
SUBAGENT_AUTO_EXPLOIT_TIMEOUT_PER_FINDING_SECONDS=300
# Where the GLOBAL app data lives (global debug.log, data/ stores, custom tools registry, mem-bridge
# handshake) -- not per-project data, that is PROJECTS_DIR above. Empty = Documents/ASRA per OS.
# Pin it if you launch ASRA both as root and as a normal user, so both see the same data.
APP_DATA_DIR=
# Absolute path (or command name) of the radare2 binary used by binary_semantic_diff. Empty = look
# it up on PATH, then in the custom tools root -- same {TOOL}_PATH convention as the other tools.
RADARE2_PATH=
